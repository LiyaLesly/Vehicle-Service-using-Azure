@model Vehicle_Service.Models.BookingService

@if (TempData["Message"] != null)
{
    <div class="alert alert-success text-center">
        @TempData["Message"]
    </div>
}
<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-header text-center bg-light">
                    <h3>ADD SERVICE</h3>
                </div>

                <div class="card-body">

                    <form asp-controller="BookingService"
                          asp-action="BookingService_Add"
                          method="post">

                        <!-- Booking ID -->
                        <input type="hidden"
                               asp-for="BookingId"
                               value="@ViewBag.BookingId" />
                        
                        <div class="form-group mb-3">

                            <label class="form-label">
                                Booking ID
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@ViewBag.BookingId"
                                   readonly />

                        </div>

                        <!-- Service -->
                        <div class="form-group mb-3">

                            <label asp-for="ServiceId"
                                   class="form-label">
                                Select Service
                            </label>

                            <select asp-for="ServiceId"
                                    class="form-control">

                                <option value="">
                                    -- SELECT SERVICE --
                                </option>

                                @foreach (var service in ViewBag.Services)
                                {
                                    <option value="@service.ServiceId">
                                        @service.ServiceName -
                                        ₹@service.estimatedcost
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ServiceId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Add Service -->
                        <div class="text-center">

                            <button type="submit"
                                    class="btn btn-primary">
                                ADD SERVICE
                            </button>
                            <a href="@Url.Action("Login_Pgload", "Customer_Login")"
                               class="btn btn-danger">
                                LOGOUT
                            </a>
                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}