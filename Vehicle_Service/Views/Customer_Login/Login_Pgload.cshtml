
@model Vehicle_Service.Models.Login

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #e8f1f8, #f8f9fa);
    }

    .login-container {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-card {
        width: 480px;
        background: white;
        padding: 35px 40px;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .login-title {
        text-align: center;
        margin-bottom: 30px;
    }

        .login-title h1 {
            font-size: 30px;
            margin-bottom: 8px;
            color: #2E8B57;
        }

        .login-title h4 {
            color: blue;
            font-size: 18px;
            margin: 0;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
            color: #444;
        }

    .my-input {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 12px;
        border: 1px solid #ccc;
        border-radius: 7px;
        font-size: 15px;
        outline: none;
    }

        .my-input:focus {
            border-color: #007bff;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.25);
        }

    .login-button {
        width: 100%;
        padding: 11px;
        border: none;
        border-radius: 7px;
        background-color: darkcyan;
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

        .login-button:hover {
            background-color: #3CB371;
        }

    .vehicle-icon {
        text-align: center;
        font-size: 45px;
        margin-bottom: 10px;
    }
</style>


<div class="login-container">

    <div class="login-card">

        <div class="vehicle-icon">
            🚗
        </div>

        <div class="login-title">
            <h1>Vehicle Service</h1>
            <h4>Login to your account</h4>
        </div>


        <form asp-controller="Customer_Login"
              asp-action="Login_clk"
              method="post">

            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Username">Username</label>
                <input asp-for="Username"
                       class="my-input"
                       placeholder="Enter your username"
                       required />
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password"
                       type="password"
                       class="my-input"
                       placeholder="Enter your password"
                       required />
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Login"
                       class="login-button" />
            </div>

            <div asp-validation-summary="ModelOnly"
                 style="color:red">
            </div>
        </form>


    </div>

</div>


@if (Model?.msg != null)
{
    <script>
        alert('@Model.msg');
    </script>
}

